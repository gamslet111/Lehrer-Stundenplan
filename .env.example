# Kopieren als .env und ausfüllen (die .env NIE weitergeben oder hochladen)
UNTIS_SERVER=htlstp.webuntis.com
UNTIS_SCHULE=htlstp
UNTIS_BENUTZER=
UNTIS_PASSWORT=

# Wie oft gescannt wird (Minuten) und wie viele Tage ab Montag dieser Woche
SCAN_MINUTEN=15
TAGE=14

# Optional: Passwort für die Webseite (Benutzername egal). Leer = kein Schutz
SEITEN_PASSWORT=
PORT=5000
